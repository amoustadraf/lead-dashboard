generator client {
  provider = "prisma-client-js"
  output   = "../src/app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id            String    @id @default(uuid()) @map("ai_table_identifier") @db.Uuid
  row_number    Int?
  first_name    String?
  last_name     String?
  email         String?
  company       String?
  title         String?
  was_contacted Boolean?
  reply_date    DateTime? @db.Date
  created_at    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  email_subject String?
  email_body    String?   @db.Text
  email_sent    Boolean?  @default(false)

  @@map("ai_table_sheet1")
}

model EmailJob {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  total     Int
  sent      Int      @default(0)
  failed    Int      @default(0)
  status    String   @default("queued") // queued | running | done | error
  failures  EmailFailure[]
}

model EmailFailure {
  id      String  @id @default(uuid())
  job_id  String
  lead_id String
  error   String
  job     EmailJob @relation(fields: [job_id], references: [id])
}